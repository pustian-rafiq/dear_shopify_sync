# Django / app
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ENVIRONMENT=production
PROJECT_TITLE=DEAR Shopify Cost Sync
PROJECT_VERSION=1.0.0
ALLOWED_HOSTS=apps.f4ip.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://apps.f4ip.com
CORS_ALLOWED_ORIGINS=https://apps.f4ip.com

# PostgreSQL — if DB runs on the Docker host, use host.docker.internal
DB_NAME=dear_shopify_sync
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=host.docker.internal
DB_PORT=5432

# Celery / Redis — must use Docker service name "redis" (not localhost)
CELERY_URL=redis://redis:6379/0

# Optional SMTP (also configurable via JobConfiguration admin)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TO_USER=
